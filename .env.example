# Copie este arquivo para ".env" e preencha os valores.
# O arquivo ".env" está no .gitignore e NUNCA deve ser versionado.

# Usa dados simulados (mock) enquanto a API real não está plugada.
# Troque para "false" quando quiser consumir a API de verdade.
VITE_USE_MOCK=true

# Endpoint que LISTA as antenas (o que retorna o JSON com status).
# Ex.: https://redesmoveisfixas.com/api/antenas?cidade=pelotas
VITE_API_URL=

# Token de acesso à API.
# ATENÇÃO: em build de frontend, qualquer VITE_* fica visível no navegador.
# Se o token for secreto, ele NÃO deve ficar aqui em produção — use um proxy/backend.
VITE_API_TOKEN=

# Como o token é enviado: "bearer" (Authorization: Bearer ...),
# "x-api-key" (header X-API-Key) ou "query" (?token=...).
VITE_API_AUTH_MODE=bearer
